# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Control Plane Database
CONTROL_PLANE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vima_control_plane

# Tenant Database Base URL (without database name)
TENANT_DATABASE_BASE_URL=postgresql://postgres:postgres@localhost:5432

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# Platform
BASE_DOMAIN=vima.app
