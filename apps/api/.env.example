# Server
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Control Plane Database
CONTROL_PLANE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vima_control_plane

# Tenant Database Base URL (without database name)
TENANT_DATABASE_BASE_URL=postgresql://postgres:postgres@localhost:5432

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production

# Platform
BASE_DOMAIN=vima.app

# Notifications - Twilio (SMS & WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Notifications - Firebase Cloud Messaging (Push)
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_KEY=  # base64-encoded service account JSON

# Notifications - Resend (Email)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Vima <noreply@vima.app>

# Notifications - Africa's Talking (SMS alternative for African markets)
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
